# Byte-compiled / optimized / DLL files
# Python compiles .py files to bytecode for faster execution
__pycache__/
*.py[cod]
*$py.class

# C extensions
# Compiled C extensions used by Python packages
*.so

# Distribution / packaging
# Build artifacts created when packaging Python projects
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# PyInstaller
# PyInstaller creates standalone executables and generates these files
*.manifest
*.spec

# Installer logs
# Created during package installation
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
# Generated by test runners and coverage tools
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/
cover/

# Translations
# Compiled translation files from i18n
*.mo
*.pot

# Django stuff
# Django framework generates these files
*.log
local_settings.py
db.sqlite3
db.sqlite3-journal

# Flask stuff
# Flask framework instance folder and cache
instance/
.webassets-cache

# Scrapy stuff
# Scrapy crawling framework cache
.scrapy

# Sphinx documentation
# Generated documentation files
docs/_build/

# PyBuilder
# Build artifacts from PyBuilder
.pybuilder/
target/

# Jupyter Notebook
# Jupyter checkpoint files - auto-saved notebook states
.ipynb_checkpoints

# IPython
# IPython profile configuration
profile_default/
ipython_config.py

# pyenv
# Python version file for pyenv version manager
.python-version

# pipenv
# Pipenv lock file - often regenerated, team may prefer to commit it
#Pipfile.lock

# poetry
# Poetry dependency lock file - often committed but can be ignored in some projects
#poetry.lock

# pdm
# PDM package manager files
.pdm.toml

# PEP 582
# PEP 582 __pypackages__ directory for local package installation
__pypackages__/

# Celery stuff
# Celery beat schedule and worker state
celerybeat-schedule
celerybeat.pid

# SageMath parsed files
# SageMath notebook cache
*.sage.py

# Environments
# Virtual environment directories - should not be committed
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# Spyder project settings
# Spyder IDE configuration files
.spyderproject
.spyproject

# Rope project settings
# Rope refactoring library configuration
.ropeproject

# mkdocs documentation
# MkDocs build output
/site

# mypy
# MyPy type checker cache
.mypy_cache/
.dmypy.json
dmypy.json

# Pyre type checker
# Pyre type checker configuration
.pyre/

# pytype static type analyzer
# Pytype analyzer cache
.pytype/

# Cython debug symbols
# Debugging symbols from Cython compiled code
cython_debug/

# PyCharm
# JetBrains PyCharm IDE configuration
.idea/

# VS Code
# Visual Studio Code workspace settings (some teams commit .vscode/settings.json)
.vscode/
*.code-workspace

# macOS
# macOS system files - not relevant to project
.DS_Store
.AppleDouble
.LSOverride

# macOS thumbnails
# Thumbnail cache files created by macOS Finder
._*

# macOS directory attributes
# Hidden macOS folder attributes
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent

# macOS network storage
# macOS network storage metadata
.AppleDB
.AppleDesktop
Network Trash Folder
Temporary Items
.apdisk

# Windows
# Windows system files - for cross-platform projects
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.stackdump
[Dd]esktop.ini
$RECYCLE.BIN/
*.cab
*.msi
*.msix
*.msm
*.msp
*.lnk

# Linux
# Linux temporary files
*~
.directory
.Trash-*

# Secrets and credentials
# Environment variables and secrets should NEVER be committed
.env
.env.local
.env.*.local
*.pem
*.key
secrets.yml
credentials.json

# Data files
# Large data files and temporary data - should use git-lfs or external storage
*.csv
*.dat
*.db
*.sqlite
*.parquet
data/
datasets/

# Model files
# Large ML model files - should use git-lfs or model registry
*.h5
*.pkl
*.pickle
*.joblib
*.onnx
*.pb
models/
checkpoints/

# Logs
# Application and system logs
logs/
*.log

# Temporary files
# Various temporary files created during development
tmp/
temp/
*.tmp
*.bak
*.swp
*.swo
*~.nib
